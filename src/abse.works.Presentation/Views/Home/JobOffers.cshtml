@using Microsoft.AspNetCore.Mvc;
@using abse.works.Application.ViewModels.JobOffer;
@using abse.works.Application.ViewModels.HomePage;
@model JobOffersListViewModel;
@{
    ViewData["Title"] = "Oferty pracy";
}

<body class="bgdark">
    <style>
        .page-item.active .page-link {
            border-color: #FECB05;
            background-color: #FECB05;
        }

        .page-link:hover{
            color: white
        }

        .work-pill:hover{
            transition-duration: 0.2s;
            background-color: hsl(0, 0%, 12%)
        }
    </style>

    <div>
        <div class="container">

            @if(Model is not null)
            {
                <div class="bgyellow p-4 roundBorderBottom text-center mb-5">
                    <h1 class="gothic-regular">Praca</h1>
                </div>

                <div class="bgyellow p-4 roundBorder roundBorderBottom">
                    @foreach (var i in Model.Offers)
                    {
                        <a class="job-tile-link text-decoration-none"
                           asp-controller="Home"
                           asp-action="JobOfferDetails"
                           asp-route-id="@i.Id"
                           style="display: block;">
                            <div class="work-pill d-flex align-items-center justify-content-between mb-3 bgdark px-4 py-3 rounded-pill shadow" style="min-height: 48px;">
                                <div class="d-flex align-items-center">
                                    <span class="me-3">
                                        <img src="~/content/logoyellow.png" style="height: auto; width: 40px; margin-bottom: 5px;" />
                                    </span>
                                    <span class="fw-bold text-light" style="font-size: 1.1rem;">@i.Position</span>
                                </div>
                                <span class="d-none d-sm-inline">
                                    <span class="btn btn-outline-warning fw-bold px-4 py-1 rounded-pill fyellow bgdark">
                                        Przejdź
                                    </span>
                                </span>
                            </div>
                        </a>
                    }

                    <div class="d-flex justify-content-end p-2">
                        <div class="d-flex align-items-center">
                            <span class="text-dark me-2">Ilość na stronie:</span>
                            <select class="form-select bgdark text-light border-0 rounded-pill fw-bold"
                                    style="width: 80px;"
                                    id="pageSizeSelect"
                                    asp-for="PageSize"
                                    onchange="updatePageSize(this.value)">
                                <option value="5">5</option>
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                    </div>

                    <nav class="mt-3 roundBorder roundBorderBottom">
                        <ul class="pagination justify-content-center align-content-center pt-3">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link fw-bold fyellow border-0 bg-transparent"
                                   asp-controller="Home"
                                   asp-action="JobOffers"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   tabindex="-1">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            <li class="page-item @(Model.CurrentPage == 1 ? "active" : "")">
                                <a class="page-link fw-bold @(Model.CurrentPage == 1 ? "bgyellow text-dark" : "fyellow bg-transparent") rounded-pill mx-1"
                                   asp-controller="Home"
                                   asp-action="JobOffers"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.PageSize">1</a>
                            </li>

                            @{
                                int totalPages = Model.TotalPages;
                                int currentPage = Model.CurrentPage;

                                int startPage = Math.Max(2, currentPage - 2);
                                int endPage = Math.Min(totalPages - 1, currentPage + 2);

                                if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link fyellow bg-transparent border-0">...</span>
                                    </li>
                                }

                                for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <a class="page-link fw-bold @(currentPage == i ? "bgyellow text-dark" : "fyellow bg-transparent") rounded-pill mx-1"
                                           asp-controller="Home"
                                           asp-action="JobOffers"
                                           asp-route-page="@i"
                                           asp-route-pageSize="@Model.PageSize">@i</a>
                                    </li>
                                }

                                if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link fyellow bg-transparent border-0">...</span>
                                    </li>
                                }
                            }

                            @if (Model.TotalPages > 1)
                            {
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "active" : "")">
                                    <a class="page-link fw-bold @(Model.CurrentPage == Model.TotalPages ? "bgyellow text-dark" : "fyellow bg-transparent") rounded-pill mx-1"
                                       asp-controller="Home"
                                       asp-action="JobOffers"
                                       asp-route-page="@Model.TotalPages"
                                       asp-route-pageSize="@Model.PageSize">@Model.TotalPages</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link fw-bold fyellow border-0 bg-transparent"
                                   asp-controller="Home"
                                   asp-action="JobOffers"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
            else
            {
                <div class="bgyellow p-4 roundBorderBottom text-center mb-5">
                    <h1 class="gothic-regular">Nic tu nie ma :(</h1>
                </div>
            }
        </div>
    </div>
    <script>
    function updatePageSize(newSize) {
        window.location.href = `@Url.Action("JobOffers", "Home")?page=1&pageSize=${newSize}`;
    }
    
    document.getElementById('pageSizeSelect').value = @Model.PageSize;
    </script>
</body>
